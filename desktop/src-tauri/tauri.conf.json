{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HomeChat",
  "version": "0.15.2",
  "identifier": "ca.homechat.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../client run dev:desktop",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../client run build:desktop",
    "frontendDist": "../../client/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HomeChat",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "SocialNetworking",
    "shortDescription": "HomeChat desktop client",
    "longDescription": "Windows desktop client for a self-hosted HomeChat server.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
