# Address clients use to reach HomeChat. Used when generating the HTTPS certificate.
HOMECHAT_HOST=192.168.1.50

# Published Docker ports.
HOMECHAT_HTTP_PORT=8092
HOMECHAT_HTTPS_PORT=8093

# Default: Docker-managed named volume "homechat-data".
# Existing bind-mount installs can preserve their current data by setting an absolute path here.
# HOMECHAT_DATA_PATH=/srv/homechat

# Optional first-run administrator bootstrap. Ignored after the first user exists.
HOMECHAT_ADMIN_NAME=Admin
HOMECHAT_ADMIN_PASSWORD=change-me-before-first-start
# Prefer a mounted secret file where available; this overrides HOMECHAT_ADMIN_PASSWORD.
# HOMECHAT_ADMIN_PASSWORD_FILE=/run/secrets/homechat_admin_password

HOMECHAT_AUTO_TLS=true
TZ=UTC

# Web Push VAPID contact identity. Keys are generated once and stored under appdata/push/.
HOMECHAT_VAPID_SUBJECT=mailto:homechat@example.invalid
