<Page
    x:Class="HomeChat.GameBar.HomeChatWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HomeChat.GameBar"
    Background="{StaticResource HomeChatBackground}">

    <Grid Padding="12">
        <Grid x:ConnectionId='2' x:Name="LoginView">
            <StackPanel VerticalAlignment="Center" MaxWidth="420" Spacing="10">
                <TextBlock Text="HomeChat" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Sign in to chat without leaving your game." Foreground="{StaticResource HomeChatMuted}" TextWrapping="Wrap" />
                <TextBox x:ConnectionId='21' x:Name="ServerBox" Header="Server" PlaceholderText="https://192.168.98.43:8093" />
                <TextBox x:ConnectionId='22' x:Name="DisplayNameBox" Header="Display name" />
                <PasswordBox x:ConnectionId='23' x:Name="PasswordBox" Header="Password" />
                <Button x:ConnectionId='24' x:Name="LoginButton" Content="Sign in" HorizontalAlignment="Stretch"                           />
                <TextBlock x:ConnectionId='25' x:Name="LoginError" Foreground="#FFFF6B6B" TextWrapping="Wrap" />
                <TextBlock Text="The HomeChat root certificate must already be trusted by Windows." Foreground="{StaticResource HomeChatMuted}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Grid x:ConnectionId='3' x:Name="ChatView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="HomeChat" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:ConnectionId='20' x:Name="IdentityText" Foreground="{StaticResource HomeChatMuted}" FontSize="12" />
                </StackPanel>
                <Button x:ConnectionId='19' Grid.Column="1" Content="Sign out"                            />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" MinWidth="120" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource HomeChatPanel}" CornerRadius="6" Padding="4">
                    <ListView x:ConnectionId='14' x:Name="ConversationList"                                                     >
                        <ListView.ItemTemplate>
                            <DataTemplate                                >
                                <Grid x:ConnectionId='16' Padding="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:ConnectionId='17'                                   TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:ConnectionId='18' Grid.Column="1"                                        Foreground="{StaticResource HomeChatAccent}" Margin="8,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <Border Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="#33FFFFFF" />

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:ConnectionId='5' x:Name="ConversationTitle" FontSize="18" FontWeight="SemiBold" Margin="4,0,0,8" Text="Choose a conversation" />

                    <ListView x:ConnectionId='6' x:Name="MessageList" Grid.Row="1" IsItemClickEnabled="False" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate                           >
                                <Border x:ConnectionId='10' Background="{StaticResource HomeChatPanel}" CornerRadius="6" Padding="8" Margin="0,3">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:ConnectionId='12'                                    FontWeight="SemiBold" />
                                            <TextBlock x:ConnectionId='13' Grid.Column="1"                          Foreground="{StaticResource HomeChatMuted}" FontSize="11" />
                                        </Grid>
                                        <TextBlock x:ConnectionId='11'                             TextWrapping="WrapWholeWords" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:ConnectionId='7' x:Name="ComposerBox" PlaceholderText="Type a message"                               IsEnabled="False" />
                        <Button x:ConnectionId='8' x:Name="SendButton" Grid.Column="1" Content="Send" Margin="8,0,0,0"                          IsEnabled="False" />
                    </Grid>
                </Grid>
            </Grid>

            <TextBlock x:ConnectionId='4' x:Name="StatusText" Grid.Row="2" Foreground="{StaticResource HomeChatMuted}" FontSize="11" Margin="0,8,0,0" Text="Ready" />
        </Grid>
    </Grid>
</Page>

