<Page
    x:Class="HomeChat.GameBar.HomeChatWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HomeChat.GameBar"
    Background="{StaticResource HomeChatBackground}">

    <Grid Padding="12">
        <Grid x:Name="LoginView">
            <StackPanel VerticalAlignment="Center" MaxWidth="420" Spacing="10">
                <TextBlock Text="HomeChat" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Sign in to chat without leaving your game." Foreground="{StaticResource HomeChatMuted}" TextWrapping="Wrap" />
                <TextBox x:Name="ServerBox" Header="Server" PlaceholderText="https://192.168.98.43:8093" />
                <TextBox x:Name="DisplayNameBox" Header="Display name" />
                <PasswordBox x:Name="PasswordBox" Header="Password" />
                <Button x:Name="LoginButton" Content="Sign in" HorizontalAlignment="Stretch" Click="LoginButton_Click" />
                <TextBlock x:Name="LoginError" Foreground="#FFFF6B6B" TextWrapping="Wrap" />
                <TextBlock Text="The HomeChat root certificate must already be trusted by Windows." Foreground="{StaticResource HomeChatMuted}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Grid x:Name="ChatView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="HomeChat" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="IdentityText" Foreground="{StaticResource HomeChatMuted}" FontSize="12" />
                </StackPanel>
                <Button Grid.Column="1" Content="Sign out" Click="LogoutButton_Click" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" MinWidth="120" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource HomeChatPanel}" CornerRadius="6" Padding="4">
                    <ListView x:Name="ConversationList" SelectionChanged="ConversationList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:Conversation">
                                <Grid Padding="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind BadgeText, Mode=OneWay}" Foreground="{StaticResource HomeChatAccent}" Margin="8,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="ConversationTitle" FontSize="18" FontWeight="SemiBold" Margin="4,0,0,8" Text="Choose a conversation" />

                    <ListView x:Name="MessageList" Grid.Row="1" IsItemClickEnabled="False" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:Message">
                                <Border Background="{StaticResource HomeChatPanel}" CornerRadius="6" Padding="8" Margin="0,3">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Sender.DisplayName}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind TimeText}" Foreground="{StaticResource HomeChatMuted}" FontSize="11" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind DisplayBody}" TextWrapping="WrapWholeWords" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ComposerBox" PlaceholderText="Type a message" KeyDown="ComposerBox_KeyDown" IsEnabled="False" />
                        <Button x:Name="SendButton" Grid.Column="1" Content="Send" Margin="8,0,0,0" Click="SendButton_Click" IsEnabled="False" />
                    </Grid>
                </Grid>
            </Grid>

            <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="{StaticResource HomeChatMuted}" FontSize="11" Margin="0,8,0,0" Text="Ready" />
        </Grid>
    </Grid>
</Page>
